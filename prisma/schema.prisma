generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String
  role      String
  status    String
  avatar    String?
  createdAt DateTime @default(now())

  // Relations
  tasksAssigned       Task[]         @relation("AssignedTasks")
  ordersCreated       Order[]        @relation("CreatedOrders")
  ordersAssigned      Order[]        @relation("AssignedOrders")
  staffCheckIns       StaffCheckIn[]
  messagesSent        Message[]      @relation("SentMessages")
  messagesReceived    Message[]      @relation("ReceivedMessages")
  // Pay profile: defaults that pre-fill the monthly payroll draft, where every
  // figure can still be adjusted. Money is whole VND, rates are percent.
  payType             String         @default("MONTHLY") // MONTHLY (lương cứng) | HOURLY (theo giờ)
  baseSalary          Int?           @default(0)
  hourlyRate          Int            @default(0) // also the base for overtime pay
  commissionRate      Float?         @default(0) // % of the products this person made
  salesCommissionRate Float          @default(0) // % of orders this person sold
  onlineHourlyRate    Int? // sales: hourly rate for online (at-home) shifts; null = hourlyRate
  otHourlyRate        Int? // overtime and "ca gấp" per hour; null = hourlyRate x the payroll's OT multiplier
  allowances          Json           @default("[]") // fixed monthly allowances [{label, amount}], paid in full
  holidayHourlyRate   Int? // hourly rate on public holidays; null = hourlyRate
  daysOffPerMonth     Int            @default(4) // MONTHLY: paid days off; base = salary x days worked / (days in month - this)

  // Auth. passwordHash is null until a manager sets a temporary password.
  passwordHash       String?
  mustChangePassword Boolean   @default(false)
  // Bumped on password change/reset so every existing session cookie dies.
  sessionVersion     Int       @default(0)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
}

model StoreLocation {
  id         String   @id @default(uuid())
  label      String
  lat        Float
  lng        Float
  address    String?
  created_at DateTime @default(now())
}

model Order {
  id                    String   @id @default(uuid())
  code                  String   @unique
  customerName          String
  customerPhone         String
  receiverName          String
  receiverPhone         String
  bouquetName           String
  bouquetImage          String?
  receiveTime           DateTime
  deliveryType          String
  deliveryAddress       String?
  status                String
  listedPrice           Int
  deliveryFee           Int?
  deliveryCoveredByShop Boolean?
  vatPercent            Float?
  deposit               Int?
  sellingPrice          Int?
  remainingBalance      Int?
  total                 Int
  notes                 String? // special note for the florists ("Ghi chú đặc biệt")
  cardMessage           String? // text written on the card ("Nội dung thiệp")
  createdById           String?
  createdByName         String?
  assigneeId            String?
  assigneeName          String?
  new_customer          Boolean? @default(false)
  createdAt             DateTime @default(now())
  customerId            String?
  // Staff member credited with the sale (whoever brought the order in - any
  // staff member); earns the sales commission. Defaults to the creator.
  salespersonId         String?
  salespersonName       String?
  // One-off id sent by "Tạo đơn"; a retried request returns the existing order.
  requestId             String?  @unique

  createdBy User?     @relation("CreatedOrders", fields: [createdById], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
  assignee  User?     @relation("AssignedOrders", fields: [assigneeId], references: [id])
  tasks     Task[]
  payments  OrderPayment[]

  @@index([customerId])
}

// A failed sign-in from a client IP (lib/server/login-throttle.ts).
model LoginFailure {
  id String   @id @default(uuid())
  ip String
  at DateTime @default(now())

  @@index([ip, at])
}

// Money a customer paid for an order (the deposit, the rest...), one row per
// transfer, recorded by staff when it arrives. The order's `deposit` is their
// sum ("Đã thu"). Sales KPI counts each payment in the shift it arrived in.
model OrderPayment {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Int
  paidAt         DateTime @default(now())
  recordedById   String?
  recordedByName String?
  note           String?
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([paidAt])
}

// One row per buyer, keyed by normalised phone (digits only, +84 -> 0) so that
// "0901 234 567", "0901234567" and "+84901234567" are the same customer.
// Orders keep their own name/phone snapshot; this holds what sales learns over time.
model Customer {
  id               String   @id @default(uuid())
  phone            String   @unique
  name             String
  notes            String?
  source           String?
  marketingConsent Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders Order[]
}

// Per-day order sequence for readable codes like "211026-047" (Vietnam date).
// Incremented atomically with INSERT ... ON CONFLICT so concurrent orders never share a number.
model OrderCounter {
  day   String @id // YYYY-MM-DD, Vietnam time
  value Int
}

model Task {
  id                 String    @id @default(uuid())
  orderId            String?
  orderCode          String?
  bouquetName        String
  bouquetImage       String?
  taskTitle          String
  samplePhotoUrls    String? // JSON string
  status             String
  dueTime            DateTime
  startTime          DateTime?
  completedAt        DateTime?
  completionProofUrl String?
  notes              String?
  type               String
  quantity           Int       @default(1)
  price              Int?

  order        Order?  @relation(fields: [orderId], references: [id])
  assigneeId   String?
  assignee     User?   @relation("AssignedTasks", fields: [assigneeId], references: [id])
  assigneeName String?

  lastAssigneeName String?
  lastAssignedAt   DateTime?
  createdAt        DateTime  @default(now())
}

model StaffCheckIn {
  id                   String    @id @default(uuid())
  staffId              String
  staffName            String
  discipline           String
  timestamp            DateTime
  checkInAt            DateTime?
  checkOutAt           DateTime?
  workingHours         Float?
  locationLabel        String
  locationType         String
  lat                  Float
  lng                  Float
  distanceFromOfficeKm Float
  ordersTouched        Int       @default(0)
  completedTasks       Int       @default(0)
  notes                String?
  requiresReview       Boolean?
  verificationStatus   String?
  verificationNote     String?
  // Vietnam calendar day of the shift (YYYY-MM-DD); one shift per person per day.
  workDate             String
  // Closed by the nightly job at closing time because nobody checked out.
  autoClosed           Boolean   @default(false)
  // Set when the times were entered or fixed by hand (forgotten check-in/out).
  correctedAt          DateTime?
  correctedById        String?
  correctedByName      String?
  correctionReason     String?

  // SHOP (at the shop) or ONLINE (sales working from home, own hourly rate, no OT).
  workMode String @default("SHOP")

  staff User @relation(fields: [staffId], references: [id])

  @@unique([staffId, workDate, workMode])
}

// Shop-wide settings (single row, id = 1).
model ShopSettings {
  id           Int    @id @default(1)
  openTime     String @default("08:00") // HH:mm, Vietnam time
  closeTime    String @default("19:00") // HH:mm; time worked outside open-close is overtime
  // Overtime (hours outside open-close) is paid at hourlyRate x otMultiplier once a manager approves it.
  otMultiplier Float  @default(1.5)
  // Public holidays: JSON [{"date":"YYYY-MM-DD","name":"..."}]; hourly staff are paid holidayHourlyRate.
  holidays     String @default("[]")
  // Sales KPI: shifts [{name, start, end}] and tiers [{revenue, bonus}] as JSON; "" = the defaults in lib/server/kpi.ts.
  kpiShifts    String @default("")
  kpiTiers     String @default("")
}

model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  fromId    String
  toId      String

  from User @relation("SentMessages", fields: [fromId], references: [id])
  to   User @relation("ReceivedMessages", fields: [toId], references: [id])
}

model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  type        String
  image       String?
  unit        String
  onHand      Int      @default(0)
  reserved    Int      @default(0)
  status      String   @default("ok")
  lastUpdated DateTime @default(now()) @updatedAt
}

// Who did what, when: one row per change to orders, tasks, staff accounts and
// customers, plus sign-ins. `changes` holds {field: [before, after]} for edits.
// Never stores password hashes or other secrets.
model AuditLog {
  id       String   @id @default(uuid())
  at       DateTime @default(now())
  userId   String?
  userName String?
  action   String // e.g. "order.update", "task.complete", "auth.login_failed"
  entity   String // "order" | "task" | "user" | "customer" | "auth"
  entityId String?
  summary  String?
  changes  Json?

  @@index([entity, entityId])
  @@index([at])
}

// Monthly payroll: a draft pre-filled from attendance and orders that a
// manager adjusts (OT days, commission items, adjustments) and then locks.
model Payroll {
  id           String        @id @default(uuid())
  month        String        @unique // YYYY-MM, Vietnam time
  status       String        @default("DRAFT") // DRAFT | LOCKED
  otMultiplier Float         @default(1.5)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lockedAt     DateTime?
  lockedByName String?
  lines        PayrollLine[]
}

// One person's pay for the month. Rates are copied from the pay profile when
// the draft is built and may be changed for this month only. `shifts`,
// `commissions` and `adjustments` hold the itemised, editable detail; `total`
// is recomputed on every save.
model PayrollLine {
  id                String  @id @default(uuid())
  payrollId         String
  payroll           Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  userId            String
  userName          String
  role              String
  payType           String // MONTHLY | HOURLY
  baseSalary        Int     @default(0)
  hourlyRate        Int     @default(0)
  makerRate         Float   @default(0)
  salesRate         Float   @default(0)
  onlineHourlyRate  Int?
  otHourlyRate      Int?
  allowances        Json    @default("[]")
  holidayHourlyRate Int?
  daysOffPerMonth   Int     @default(4)
  // Set when a manager changed this month's rates; otherwise a refresh re-copies the pay profile.
  ratesOverridden   Boolean @default(false)
  shifts            Json    @default("[]")
  commissions       Json    @default("[]")
  adjustments       Json    @default("[]")
  // Sales KPI bonuses per shift: [{key, date, shift, revenue, bonus, payments, included}].
  kpi               Json    @default("[]")
  note              String?
  total             Int     @default(0)

  @@unique([payrollId, userId])
}
