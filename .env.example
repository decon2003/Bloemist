# Copy to .env for local development (never commit .env).
# Point DATABASE_URL at a local or throwaway database - never at devtest or
# production. For one-off scripts against a real database, set the variable in
# the terminal instead of saving it here (see DEPLOY.md).

# Neon connection string. Use the -pooler host for the app on Vercel and the
# direct host for prisma migrate / scripts.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# >= 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Optional locally: without it, dev makes a random one each start.
AUTH_SECRET=""

# Bearer token Vercel Cron sends to /api/cron/*. Only needed on Vercel.
CRON_SECRET=""

# Cloudflare R2 (photos + backups). Leave empty to keep storing photos inline.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="bloemist-photos"
