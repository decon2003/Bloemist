# Copy to .env for local scripts (never commit .env).

# Neon connection string. Use the -pooler host for the app on Vercel and the
# direct host for prisma migrate / scripts.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# >= 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Cloudflare R2 (photos + backups). Leave empty to keep storing photos inline.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="bloemist-photos"
